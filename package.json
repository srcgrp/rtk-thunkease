{
  "name": "rtk-thunkease",
  "version": "0.1.0",
  "description": "Redux Toolkit createSlice wrapper that generates loading/error/data state and the full pending/rejected/fulfilled triad for every async thunk you hand it.",
  "keywords": [
    "redux",
    "redux-toolkit",
    "rtk",
    "createSlice",
    "createAsyncThunk",
    "thunk",
    "async",
    "typescript",
    "react"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/srcgrp/rtk-thunkease.git"
  },
  "bugs": "https://github.com/srcgrp/rtk-thunkease/issues",
  "homepage": "https://github.com/srcgrp/rtk-thunkease#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "react": [
        "./dist/react/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "react"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "publint && attw --pack .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "prepublishOnly": "pnpm build && pnpm test && pnpm typecheck"
  },
  "peerDependencies": {
    "@reduxjs/toolkit": "^2.0.0",
    "react": ">=18",
    "react-redux": ">=9"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-redux": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^2.31.1",
    "@reduxjs/toolkit": "^2.5.0",
    "@testing-library/react": "^16.2.0",
    "@types/react": "^18.3.18",
    "jsdom": "^26.0.0",
    "publint": "^0.3.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.2.0",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=18"
  }
}
